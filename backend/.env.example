# ========================================
# F.R.I.D.A.Y. Backend Configuration
# ========================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# LLM & STT (Free: https://console.groq.com)
GROQ_API_KEY=

# Vision & Embeddings (Free: https://aistudio.google.com)
GOOGLE_API_KEY=

# Memory (self-hosted — no API key needed, local file storage)
# QDRANT_PATH=./data/qdrant_local  # Default, auto-created

# User Config
FRIDAY_USER_NAME=Alan
FRIDAY_USER_ID=alan

# Server
HOST=0.0.0.0
PORT=8000

# Model Config (Optional — defaults are fine)
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_STT_MODEL=whisper-large-v3
# GEMINI_VISION_MODEL=gemini-2.0-flash
# EDGE_TTS_VOICE=en-US-GuyNeural
